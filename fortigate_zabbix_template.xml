<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
  <version>7.4</version>
  <template_groups>
    <template_group>
      <uuid>4dc52456f61c4ba3b5834b355a8439a6</uuid>
      <name>Templates/Network devices</name>
    </template_group>
  </template_groups>
  <templates>
    <template>
      <uuid>46a31d078e024706a5bd0aa013088fed</uuid>
      <template>FortiGate SNMP</template>
      <name>FortiGate Firewall SNMP Monitoring</name>
      <description>Generic template for Fortinet FortiGate firewalls.&#13;
&#13;
Monitors: CPU, Memory, Traffic (LLD), Temperature (LLD),&#13;
VPN Tunnels (LLD), SD-WAN SLA/Jitter/Ping, Security (IPS/AV), SSL Certificates, HA&#13;
&#13;
Requirements:&#13;
- SNMP v2c enabled on FortiGate (System > SNMP)&#13;
- Macro {$SNMP_COMMUNITY} configured at host level&#13;
- MIBs: FORTINET-FORTIGATE-MIB, IF-MIB</description>
      <groups>
        <group>
          <name>Templates/Network devices</name>
        </group>
      </groups>

      <!-- ======================== -->
      <!-- MACROS -->
      <!-- ======================== -->
      <macros>
        <macro>
          <macro>{$SNMP_COMMUNITY}</macro>
          <value>public</value>
          <description>SNMP v2c community string - override at host level</description>
        </macro>
        <macro>
          <macro>{$CPU_WARN}</macro>
          <value>80</value>
          <description>CPU usage warning threshold (%)</description>
        </macro>
        <macro>
          <macro>{$CPU_CRIT}</macro>
          <value>95</value>
          <description>CPU usage critical threshold (%)</description>
        </macro>
        <macro>
          <macro>{$MEM_WARN}</macro>
          <value>85</value>
          <description>Memory usage warning threshold (%)</description>
        </macro>
        <macro>
          <macro>{$TEMP_WARN}</macro>
          <value>65</value>
          <description>Temperature warning threshold (Celsius)</description>
        </macro>
        <macro>
          <macro>{$TEMP_CRIT}</macro>
          <value>80</value>
          <description>Temperature critical threshold (Celsius)</description>
        </macro>
        <macro>
          <macro>{$SLA_LATENCY_WARN}</macro>
          <value>100</value>
          <description>SLA RTT warning threshold (ms)</description>
        </macro>
        <macro>
          <macro>{$SLA_JITTER_WARN}</macro>
          <value>50</value>
          <description>SLA jitter warning threshold (ms)</description>
        </macro>
        <macro>
          <macro>{$SLA_PACKETLOSS_WARN}</macro>
          <value>5</value>
          <description>SLA packet loss warning threshold (%)</description>
        </macro>
        <macro>
          <macro>{$SSL_CERT_WARN_DAYS}</macro>
          <value>30</value>
          <description>Days before SSL certificate expiry to warn</description>
        </macro>
        <macro>
          <macro>{$SSL_CERT_CRIT_DAYS}</macro>
          <value>7</value>
          <description>Days before SSL certificate expiry - critical alert</description>
        </macro>
      </macros>

      <!-- ======================== -->
      <!-- ITEMS -->
      <!-- ======================== -->
      <items>

        <!-- ======================== -->
        <item>
          <uuid>5f12ef2ec541435d865de8d2a78fb510</uuid>
          <name>CPU - Management CPU Usage</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.4.1.12356.101.4.1.3.0</snmp_oid>
          <key>fortigate.cpu.usage</key>
          <delay>60s</delay>
          <units>%</units>
          <description>fgSysCpuUsage - Management CPU utilization</description>
          <tags>
            <tag><tag>component</tag><value>cpu</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>e1a79b7868ac43ffa91af56a714d05b6</uuid>
              <expression>avg(/FortiGate SNMP/fortigate.cpu.usage,5m)>{$CPU_WARN}</expression>
              <name>CPU usage above {$CPU_WARN}% on {HOST.NAME}</name>
              <priority>WARNING</priority>
            </trigger>
            <trigger>
              <uuid>ca4f6d731a724bd7a3944b77414c1b95</uuid>
              <expression>avg(/FortiGate SNMP/fortigate.cpu.usage,5m)>{$CPU_CRIT}</expression>
              <name>CPU usage CRITICAL above {$CPU_CRIT}% on {HOST.NAME}</name>
              <priority>HIGH</priority>
            </trigger>
          </triggers>
        </item>

        <item>
          <uuid>7b2d01ec8b584c8fb7ff1dbe270442de</uuid>
          <name>CPU - IPS/AV Engine Usage</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.4.1.12356.101.4.1.6.0</snmp_oid>
          <key>fortigate.cpu.av</key>
          <delay>60s</delay>
          <units>%</units>
          <description>fgSysCpuUsageNice - IPS/AV engine CPU utilization</description>
          <tags>
            <tag><tag>component</tag><value>cpu</value></tag>
          </tags>
        </item>

        <!-- ======================== -->
        <item>
          <uuid>74a2f7e1a91a4c66a5032616ea4fecab</uuid>
          <name>Memory Usage</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.4.1.12356.101.4.1.4.0</snmp_oid>
          <key>fortigate.mem.usage</key>
          <delay>60s</delay>
          <units>%</units>
          <description>fgSysMemUsage - Memory usage percentage</description>
          <tags>
            <tag><tag>component</tag><value>memory</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>b5d02295aab34e5193107bda8b191b84</uuid>
              <expression>avg(/FortiGate SNMP/fortigate.mem.usage,5m)>{$MEM_WARN}</expression>
              <name>Memory usage above {$MEM_WARN}% on {HOST.NAME}</name>
              <priority>WARNING</priority>
            </trigger>
          </triggers>
        </item>

        <!-- ======================== -->
        <item>
          <uuid>faaaa02db2974bee898038851523f81c</uuid>
          <name>Active Sessions Count</name>
          <type>SNMP_AGENT</type>
          <snmp_oid>1.3.6.1.4.1.12356.101.4.1.8.0</snmp_oid>
          <key>fortigate.sessions.count</key>
          <delay>60s</delay>
          <units>sessions</units>
          <description>fgSysSesCount - Number of active firewall sessions</description>
          <tags>
            <tag><tag>component</tag><value>traffic</value></tag>
          </tags>
        </item>

        <!-- SLA RTT, Jitter and Packet Loss are discovered via LLD (see Discovery Rules) -->

        <!-- ICMP Ping from Zabbix server -->
        <item>
          <uuid>b3f791c2e75246da9971616ea49aff0d</uuid>
          <name>ICMP Ping - Response Time</name>
          <type>SIMPLE</type>
          <key>icmppingsec</key>
          <delay>60s</delay>
          <units>s</units>
          <description>ICMP round-trip time from Zabbix server to FortiGate</description>
          <tags>
            <tag><tag>component</tag><value>sla</value></tag>
          </tags>
        </item>

        <item>
          <uuid>ec9ef0cea6e540408b3d41d8d1214609</uuid>
          <name>ICMP Ping - Availability</name>
          <type>SIMPLE</type>
          <key>icmpping</key>
          <delay>60s</delay>
          <description>1=reachable, 0=unreachable</description>
          <tags>
            <tag><tag>component</tag><value>sla</value></tag>
          </tags>
          <triggers>
            <trigger>
              <uuid>e72614469e404dc5975f5caba1ed6368</uuid>
              <expression>max(/FortiGate SNMP/icmpping,#3)=0</expression>
